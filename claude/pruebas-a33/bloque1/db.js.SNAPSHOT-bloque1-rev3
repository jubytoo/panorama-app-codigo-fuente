  },
  _leerGen: () => leerGen(),
  _clasificar: clasificar,
  _fotografiar: (f) => fotografiar(!!f),
  _registro: () => registroA33.slice(),
  // Solo para las pruebas: inyecta un fallo en un punto de la primera apertura.
  _inyectarFalloEn: (p) => { _fallarEn = p || null; return _fallarEn; },
  // Solo para las pruebas: reinicia el módulo entre casos.
  _resetParaPruebas: () => {
    _fallarEn = null;
    try { if (db) db.close(); } catch (e) {}
    db = null; dbFilePath = null; genFilePath = null; dirty = false;
    cMem = null; pMem = null; hMem = []; gMem = 0; fMio = null; sMio = null;
    ultimaImagenConfirmada = null; escrituraBloqueada = null; fsyncAvisado = false;
    politica = 'local'; wYo = null; registroA33.length = 0;
