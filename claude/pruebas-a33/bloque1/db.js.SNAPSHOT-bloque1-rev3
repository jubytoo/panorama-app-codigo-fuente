    escrituraBloqueada, dbFilePath, genFilePath,
    tieneImagenConfirmada: !!ultimaImagenConfirmada,
    ultimaImagenConfirmada,
  }),
  // Diagnóstico. Admite una carpeta para poder inspeccionar ANTES de abrir;
  // solo fija las rutas si todavía no lo estaban, nunca las cambia en caliente.
  _leerDisco: (dirOpcional) => {
    if (dirOpcional && !dbFilePath) {
      dbFilePath = path.join(dirOpcional, 'panorama.sqlite3');
      genFilePath = dbFilePath + '.gen';
    }
