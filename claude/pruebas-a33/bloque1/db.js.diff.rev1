+// --- lectura del .sqlite3 con ESTADOS EXPLÍCITOS ----------------------------
+// "No he podido leer" NO es "he demostrado un conflicto".
+//   'valida' | 'ausente' | 'no-disponible' | 'ilegible'
+function leerDisco() {
+  let bytes;
+  try {
+    bytes = fs.readFileSync(dbFilePath);
+  } catch (e) {
+    const cod = (e && e.code) || '';
+    if (cod === 'ENOENT') return { estado: 'ausente', motivo: 'el archivo no existe' };
+    return { estado: 'no-disponible', motivo: `no se pudo leer (${cod || e.message})`, codigo: cod };
+  }
+  let d = null;
+  try { d = new SQLjs.Database(bytes); } catch (e) { return { estado: 'ilegible', motivo: 'no abre' }; }
+  try {
+    const ic = d.exec('PRAGMA integrity_check');
+    const okIc = ic.length && ic[0].values.length && String(ic[0].values[0][0]) === 'ok';
+    if (!okIc) { d.close(); return { estado: 'ilegible', motivo: 'integrity_check' }; }
+    const r = d.exec(
+      "SELECT key,value FROM app_meta WHERE key IN " +
+      "('db_commit_id','db_parent_commit_id','db_commit_history','db_generation')"
+    );
+    const m = {};
+    if (r.length) r[0].values.forEach(([k, v]) => { m[k] = v; });
+    d.close();
+    // Una base de datos SIN db_commit_id pero CON un .gen que sí lo tiene es
+    // corrupta, no una instalación nueva: un truncado a cero abre como vacía.
+    if (!m.db_commit_id) {
+      const g = leerGen();
+      if (g) return { estado: 'ilegible', motivo: 'sin db_commit_id habiendo .gen' };
+      // Sin .gen: puede ser una base de datos de una versión ANTERIOR a A3.3,
+      // que es legítima. Se adopta y se le pondrá identidad en la primera
+      // escritura. Ver §15 del diseño (compatibilidad hacia atrás).
+      return { estado: 'valida', C: null, P: null, H: [], gen: 0, F: sha256(bytes), bytes, sinIdentidad: true };
+    }
+    return {
+      estado: 'valida',
+      C: m.db_commit_id,
+      P: m.db_parent_commit_id || null,
+      H: JSON.parse(m.db_commit_history || '[]'),
+      gen: parseInt(m.db_generation || '0', 10),
+      F: sha256(bytes),
+      bytes,
+    };
+  } catch (e) {
+    try { d.close(); } catch (e2) {}
+    return { estado: 'ilegible', motivo: String((e && e.message) || e) };
+  }
+}
+
+// --- ¿la carpeta está realmente virgen? -------------------------------------
+// Solo como comprobación ADICIONAL antes de crear, nunca como autorización.
+// Ante cualquier duda devuelve false (fail-closed).
+function pareceUbicacionNueva() {
+  const dir = path.dirname(dbFilePath);
+  let entradas;
+  try { entradas = fs.readdirSync(dir); } catch (e) {
+    return { nueva: false, motivo: 'no se pudo listar la carpeta de datos' };
+  }
+  const base = path.basename(dbFilePath);
+  const restos = entradas.filter((f) => f === base || f.startsWith(base + '.'));
+  if (restos.length) {
+    return { nueva: false, motivo: `hay restos de una base de datos anterior: ${restos.join(', ')}` };
+  }
+  return { nueva: true, motivo: 'no hay ningún rastro de una base de datos previa' };
+}
+
+// --- clasificación (función pura) -------------------------------------------
+function clasificar(e) {
+  const R = (tipo, caso, motivo, extra) => Object.assign({ tipo, caso, motivo }, extra || {});
+
+  if (e.politica === 'local' && e.gen && e.sMio && e.stat) {
+    if (e.gen.C === e.mem.C && e.stat.mtimeMs === e.sMio.mtimeMs && e.stat.size === e.sMio.size) {
+      return R('seguir', null, 'atajo local: .gen y stat sin cambios');
+    }
+  }
+  if (!e.disk) return R('leer-disco', null, 'hay que leer el .sqlite3 para clasificar');
+  if (!e.gen) {
+    return R(e.politica === 'local' ? 'reparar-gen' : 'degradado', 7,
+      'el .gen no existe o no se puede interpretar');
+  }
+
+  // RAMA A: .gen y BD del mismo commit
+  if (e.gen.C === e.disk.C) {
+    if (e.disk.C === e.mem.C) {
+      if (e.disk.F === e.mem.F) {
+        return R('seguir', null, 'mismo commit y mismos bytes; se refresca S_mio', { refrescarStat: true });
+      }
+      return R('conflicto', 8, 'el .sqlite3 cambió sin que cambiaran los identificadores');
+    }
+    if (e.disk.H.includes(e.mem.C)) {
+      if (e.dirty) return R('conflicto', 1, 'el disco desciende de lo nuestro, pero hay cambios sin confirmar');
+      return R('recarga', 1, 'descendencia lineal estricta');
+    }
+    if (e.mem.H.includes(e.disk.C)) return R('aviso-atrasado', 4, 'la imagen del disco es un ancestro nuestro');
+    if (e.gen.P && e.mem.P && e.gen.P === e.mem.P) {
+      return R('conflicto', 3, 'bifurcación concurrente: otro equipo partió del mismo commit');
+    }
+    return R('conflicto', 5, 'divergencia no demostrable');
+  }
+
+  // RAMA B: .gen y BD de commits distintos
+  const discoIntacto = (e.disk.C === e.mem.C) && (e.disk.F === e.mem.F);
+  if (!discoIntacto) {
+    const comoSiA = clasificar(Object.assign({}, e, { gen: { C: e.disk.C, P: e.disk.P, W: e.gen.W } }));
+    return Object.assign({}, comoSiA, {
+      genAdelantado: true,
+      motivo: comoSiA.motivo + ' (además hay un .gen adelantado sin resolver)',
+    });
+  }
+  if (e.gen.W === e.wYo && e.gen.P === e.disk.C && e.disk.C === e.mem.C && e.disk.F === e.mem.F) {
+    return R('reparar-gen', 2, 'mi propia escritura interrumpida');
+  }
+  if (e.gen.W !== e.wYo && e.gen.P === e.disk.C) {
+    return R('espera', 0, 'otro equipo empezó a escribir y su .sqlite3 no ha llegado');
+  }
+  return R('espera', 0, 'incoherencia: el .gen no encadena con la base de datos', { conservador: true });
+}
+
+function fotografiar(forzarLeerDisco) {
+  let st = null;
+  try { const s = fs.statSync(dbFilePath); st = { mtimeMs: s.mtimeMs, size: s.size }; } catch (e) {}
+  const gen = leerGen();
+  const disk = (forzarLeerDisco || politica !== 'local') ? leerDisco() : null;
+  return {
+    politica, dirty, wYo,
+    mem: { C: cMem, P: pMem, H: hMem, F: fMio },
+    stat: st, sMio, gen,
+    disk: disk && disk.estado === 'valida' ? disk : null,
+    diskEstado: disk ? disk.estado : null,
+    diskMotivo: disk ? disk.motivo : null,
+  };
+}
+
+function salidaPorEstadoDeDisco(e) {
+  if (e.diskEstado === 'ilegible') return { ok: false, motivo: 'bd-ilegible', detalle: e.diskMotivo };
+  if (e.diskEstado === 'no-disponible' || e.diskEstado === 'ausente') {
+    return { ok: false, motivo: 'no-verificable', detalle: e.diskMotivo, estadoDisco: e.diskEstado };
+  }
+  return null;
+}
+
+function comprobarEscrituraPosible() {
+  if (escrituraBloqueada) return { ok: false, motivo: 'bloqueado', detalle: escrituraBloqueada };
+  let e = fotografiar(false);
+  let s = salidaPorEstadoDeDisco(e);
+  if (s) return s;
+  let d = clasificar(e);
+  if (d.tipo === 'leer-disco') {
+    e = fotografiar(true);
+    s = salidaPorEstadoDeDisco(e);
+    if (s) return s;
+    d = clasificar(e);
+    if (d.tipo === 'leer-disco') {
