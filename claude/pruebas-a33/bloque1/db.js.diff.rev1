+// Códigos que SÍ significan "este sistema de archivos no implementa fsync".
+// Lista cerrada; todo lo demás es un fallo real.
+const FSYNC_NO_SOPORTADO = new Set(['EINVAL', 'ENOSYS', 'ENOTSUP', 'EOPNOTSUPP']);
