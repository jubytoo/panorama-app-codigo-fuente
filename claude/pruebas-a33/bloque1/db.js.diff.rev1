+function bloquearEscrituras(motivo) {
+  if (escrituraBloqueada && MOTIVOS_IRREVERSIBLES.has(escrituraBloqueada)) {
+    logA33(`se ignora el bloqueo '${motivo}': ya bloqueado por '${escrituraBloqueada}'`);
+    return escrituraBloqueada;
+  }
