+const registroA33 = [];
+function logA33(s) {
+  registroA33.push(new Date().toISOString() + ' ' + s);
+  if (registroA33.length > 200) registroA33.shift();
+}
+
+class ErrorDb extends Error {
+  constructor(kind, message, extra) {
+    super(message);
+    this.name = 'ErrorDb';
+    this.kind = kind;            // 'io'|'conflicto'|'bloqueado'|'ilegible'|'io-tras-confirmar'
+    this.aplicado = false;       // ¿esta sentencia llegó a disco?
