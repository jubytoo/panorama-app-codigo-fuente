+// en la carpeta de datos: si viajara por Drive dejaría de identificar nada.
+function cargarInstallationId() {
+  if (wYo) return wYo;
+  try {
+    const dirCfg = path.join(app.getPath('appData'), 'panorama-app-config');
+    const f = path.join(dirCfg, 'installation-id');
+    try {
+      const v = fs.readFileSync(f, 'utf8').trim();
+      if (v) { wYo = v; return wYo; }
+    } catch (e) { /* no existe todavía */ }
+    wYo = crypto.randomBytes(16).toString('hex');
+    fs.mkdirSync(dirCfg, { recursive: true });
+    fs.writeFileSync(f, wYo, 'utf8');
+  } catch (e) {
+    // Si ni siquiera se puede guardar, se usa uno de sesión: peor identidad,
+    // pero nunca un fallo de arranque por esto.
+    wYo = wYo || ('sesion-' + crypto.randomBytes(12).toString('hex'));
+    logA33('no se pudo persistir el installation-id: ' + String((e && e.message) || e));
+  }
+  return wYo;
+}
+
+// ---------------------------------------------------------------------------
+// ESCRITURA ATÓMICA — temporal, escritura completa, fsync, rename.
+// Nombre temporal GLOBALMENTE ÚNICO: process.pid no distingue dos PCs sobre la
+// misma carpeta sincronizada, y los .tmp supervivientes se tratan como posibles
+// imágenes de recuperación.
+// ---------------------------------------------------------------------------
+function nombreTemporal(rutaFinal, opts) {
+  const o = opts || {};
+  const w = o.writer ? String(o.writer).replace(/[^0-9a-zA-Z_-]/g, '').slice(0, 16) : 'anon';
+  const nonce = (o.commit ? String(o.commit).slice(0, 8) : '') + crypto.randomBytes(8).toString('hex');
+  return `${rutaFinal}.tmp-${w}-${nonce}`;
+}
+
+function escribirAtomico(rutaFinal, buffer, opts) {
+  const o = opts || {};
+  const conFsync = o.conFsync !== false;
+  const tmp = nombreTemporal(rutaFinal, o);
+  let completo = false;
+  let fsyncNoSoportado = false;
+
+  const fd = fs.openSync(tmp, 'w');
+  try {
+    let escritos = 0;
+    let vueltas = 0;
+    while (escritos < buffer.length) {
+      if (++vueltas > buffer.length + 16) {
+        throw new ErrorDb('io', `bucle de escritura sin fin en el byte ${escritos}`);
+      }
+      const n = fs.writeSync(fd, buffer, escritos, buffer.length - escritos, escritos);
+      if (!(n > 0)) throw new ErrorDb('io', `writeSync sin progreso en el byte ${escritos} de ${buffer.length}`);
+      escritos += n;
+    }
+    if (escritos !== buffer.length) {
+      throw new ErrorDb('io', `escritura incompleta: ${escritos}/${buffer.length}`);
+    }
+    if (conFsync) {
+      try {
+        fs.fsyncSync(fd);
+      } catch (e) {
+        if (FSYNC_NO_SOPORTADO.has(e && e.code)) {
+          fsyncNoSoportado = true;
+        } else {
+          throw new ErrorDb('io', `fsync falló (${(e && e.code) || '?'}): ${e && e.message}`);
+        }
+      }
+    }
+    completo = true;
+  } finally {
+    try { fs.closeSync(fd); } catch (e) { /* ya cerrado */ }
+    if (!completo) {
+      // El temporal NO sustituye nada. Se conserva para diagnóstico.
+      const fallido = tmp.replace('.tmp-', '.tmp-fallido-') + '-' + Date.now();
+      try { fs.renameSync(tmp, fallido); } catch (e) { /* se queda como .tmp- */ }
+    }
+  }
+  fs.renameSync(tmp, rutaFinal);   // solo con completo === true
+  if (fsyncNoSoportado && !fsyncAvisado) {
+    fsyncAvisado = true;
+    logA33('fsync no soportado en esta ubicación: garantía de durabilidad REBAJADA');
+  }
+  return { fsyncNoSoportado };
+}
+
+// --- el testigo .gen --------------------------------------------------------
+function leerGen() {
+  try {
+    const j = JSON.parse(fs.readFileSync(genFilePath, 'utf8'));
+    if (!j || j.v !== 2 || !j.commit_id || !j.writer) return null;
+    return { C: j.commit_id, P: j.parent_commit_id || null, W: j.writer, gen: j.gen };
+  } catch (e) { return null; }
+}
+
+function escribirGen(commit, parent, gen) {
+  const buf = Buffer.from(JSON.stringify({
+    v: 2, gen, commit_id: commit, parent_commit_id: parent, writer: wYo,
+    at: new Date().toISOString(),
+  }), 'utf8');
+  escribirAtomico(genFilePath, buf, { writer: wYo, commit });
+}
+
+function preservarGenComoTestigo() {
+  try {
