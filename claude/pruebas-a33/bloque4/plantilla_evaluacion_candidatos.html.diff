+// ------------------------------------------------------------------
+// A3.3/Bloque 4 — SESIÓN DETENIDA (forma 3 del contrato de acción).
+//
+// El toast dura 4,5 s y luego desaparece: no sirve para esto. Si tras
+// "aplicado:true / verificado:false" el aviso se esfuma y la ventana sigue
+// editable, el usuario puede seguir trabajando durante minutos creyendo que
+// se guarda — y no se guarda. Aquí el aviso es un banner FIJO que no se va
+// mientras la ventana siga abierta.
+//
+// Y no basta con bloquear el guardado: TODA mutación queda congelada, porque
+// algunas escriben en disco por su cuenta (los CV) y dejarlas pasar produce
+// justo la incoherencia archivo↔estado que este bloque existe para evitar.
+function mostrarAvisoPersistente(texto) {
+  let el = document.getElementById('avisoSesionDetenida');
+  if (!el) {
+    el = document.createElement('div');
+    el.id = 'avisoSesionDetenida';
+    el.setAttribute('role', 'alert');
+    el.style.cssText = 'position:fixed;left:0;right:0;top:0;z-index:99999;padding:12px 16px;' +
+      'background:#7f1d1d;color:#fff;font-weight:600;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.4);';
+    document.body.appendChild(el);
+    document.body.style.paddingTop = '48px';
+  }
+  el.textContent = texto || AVISO_SESION_DETENIDA;
+}
+const AVISO_SESION_DETENIDA =
+  'El último cambio se guardó. Esta sesión debe reiniciarse: cierra Panorama del Servicio y vuelve a ' +
+  'abrirlo. Los cambios nuevos NO se guardarán.';
+
+// Guarda ÚNICA para todas las acciones que cambian `state` o tocan archivos.
+// Va SIEMPRE antes de llamar a ningún IPC: no vale hacer el IPC y descubrir
+// después que no se puede guardar el estado.
+function mutacionesPermitidas() {
+  if (!guardadosDetenidos) return true;
+  mostrarAvisoPersistente();
+  return false;
+}
