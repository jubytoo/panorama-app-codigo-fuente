+  // al arrancar — o se conserva todo.
+  try {
+    const est = estadoDestinoAccion(journal);
+    if (modoReal === 'nuevo') {
+      if (est.clase !== 'ausente') throw new Error('el destino ya existe y debería ser único');
+      fs.renameSync(tmp, destino);
+    } else if (est.clase === 'publicado') {
